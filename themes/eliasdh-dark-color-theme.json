    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": {
                "foreground": "#6b747d",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Doc tags",
            "scope": [
                "storage.type.class.jsdoc",
                "keyword.other.phpdoc",
                "comment keyword.other"
            ],
            "settings": {
                "foreground": "#a9bdd8",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical.python",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#86b6ff"
            }
        },
        {
            "name": "Operators & punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#818a92"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#3fbf8f"
            }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#86b6ff"
            }
        },
        {
            "name": "Escapes & regex",
            "scope": [
                "constant.character.escape",
                "string.regexp",
                "constant.other.character-class"
            ],
            "settings": {
                "foreground": "#f08a5d"
            }
        },
        {
            "name": "Numbers & constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "variable.other.constant",
                "support.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#e0a32e"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "variable.function",
                "entity.name.method"
            ],
            "settings": {
                "foreground": "#5aa0f2"
            }
        },
        {
            "name": "Types & classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "entity.name.namespace",
                "storage.type.cs",
                "storage.type.java",
                "entity.name.type.interface",
                "meta.type.annotation entity.name.type"
            ],
            "settings": {
                "foreground": "#e87ba4"
            }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#f08a5d"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#edeff2"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#c9d1db",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key",
                "entity.name.tag.yaml",
                "support.type.property-name",
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#a9bdd8"
            }
        },
        {
            "name": "HTML/XML tags",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#86b6ff"
            }
        },
        {
            "name": "Components (JSX)",
            "scope": [
                "support.class.component",
                "entity.name.tag.component"
            ],
            "settings": {
                "foreground": "#e87ba4"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#f08a5d"
            }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": {
                "foreground": "#5aa0f2"
            }
        },
        {
            "name": "CSS values / units",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit",
                "constant.other.color.rgb-value"
            ],
            "settings": {
                "foreground": "#e0a32e"
            }
        },
        {
            "name": "CSS variables",
            "scope": [
                "variable.css",
                "variable.argument.css",
                "support.type.custom-property"
            ],
            "settings": {
                "foreground": "#a9bdd8"
            }
        },
        {
            "name": "Markdown heading",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown",
                "punctuation.definition.heading.markdown"
            ],
            "settings": {
                "foreground": "#86b6ff",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown strike",
            "scope": [
                "markup.strikethrough"
            ],
            "settings": {
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown link",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#5aa0f2"
            }
        },
        {
            "name": "Markdown quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#6b747d",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown list",
            "scope": [
                "punctuation.definition.list.begin.markdown"
            ],
            "settings": {
                "foreground": "#f08a5d"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file"
            ],
            "settings": {
                "foreground": "#3fbf8f"
            }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file"
            ],
            "settings": {
                "foreground": "#f87171"
            }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#e0a32e"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#f87171"
            }
        },
        {
            "name": "Deprecated",
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#e0a32e",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#e87ba4",
        "class": "#e87ba4",
        "interface": "#e87ba4",
        "enum": "#e87ba4",
        "type": "#e87ba4",
        "typeParameter": "#e87ba4",
        "function": "#5aa0f2",
        "method": "#5aa0f2",
        "decorator": "#f08a5d",
        "macro": "#f08a5d",
        "parameter": {
            "foreground": "#c9d1db",
            "italic": true
        },
        "property": "#a9bdd8",
        "enumMember": "#e0a32e",
        "variable": "#edeff2",
        "variable.readonly": "#e0a32e",
        "variable.defaultLibrary": "#e0a32e",
        "keyword": "#86b6ff",
        "regexp": "#f08a5d",
        "string": "#3fbf8f",
        "number": "#e0a32e",
        "comment": {
            "foreground": "#6b747d",
            "italic": true
        },
        "*.deprecated": {
            "strikethrough": true
        }
    }
}
