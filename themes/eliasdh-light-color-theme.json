    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": {
                "foreground": "#6f7d92",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Doc tags",
            "scope": [
                "storage.type.class.jsdoc",
                "keyword.other.phpdoc",
                "comment keyword.other"
            ],
            "settings": {
                "foreground": "#3d587b",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical.python",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#2a64b8"
            }
        },
        {
            "name": "Operators & punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#5d6b80"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#12855c"
            }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#2a64b8"
            }
        },
        {
            "name": "Escapes & regex",
            "scope": [
                "constant.character.escape",
                "string.regexp",
                "constant.other.character-class"
            ],
            "settings": {
                "foreground": "#c8501f"
            }
        },
        {
            "name": "Numbers & constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "variable.other.constant",
                "support.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#a86500"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "variable.function",
                "entity.name.method"
            ],
            "settings": {
                "foreground": "#1d6ccc"
            }
        },
        {
            "name": "Types & classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "entity.name.namespace",
                "storage.type.cs",
                "storage.type.java",
                "entity.name.type.interface",
                "meta.type.annotation entity.name.type"
            ],
            "settings": {
                "foreground": "#c4457a"
            }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#c8501f"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#1b2535"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#4a5a70",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key",
                "entity.name.tag.yaml",
                "support.type.property-name",
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#3d587b"
            }
        },
        {
            "name": "HTML/XML tags",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#2a64b8"
            }
        },
        {
            "name": "Components (JSX)",
            "scope": [
                "support.class.component",
                "entity.name.tag.component"
            ],
            "settings": {
                "foreground": "#c4457a"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#c8501f"
            }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": {
                "foreground": "#1d6ccc"
            }
        },
        {
            "name": "CSS values / units",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit",
                "constant.other.color.rgb-value"
            ],
            "settings": {
                "foreground": "#a86500"
            }
        },
        {
            "name": "CSS variables",
            "scope": [
                "variable.css",
                "variable.argument.css",
                "support.type.custom-property"
            ],
            "settings": {
                "foreground": "#3d587b"
            }
        },
        {
            "name": "Markdown heading",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown",
                "punctuation.definition.heading.markdown"
            ],
            "settings": {
                "foreground": "#2a64b8",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown strike",
            "scope": [
                "markup.strikethrough"
            ],
            "settings": {
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown link",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#1d6ccc"
            }
        },
        {
            "name": "Markdown quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#6f7d92",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown list",
            "scope": [
                "punctuation.definition.list.begin.markdown"
            ],
            "settings": {
                "foreground": "#c8501f"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file"
            ],
            "settings": {
                "foreground": "#12855c"
            }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file"
            ],
            "settings": {
                "foreground": "#e74c3c"
            }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#a86500"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#e74c3c"
            }
        },
        {
            "name": "Deprecated",
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#a86500",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#c4457a",
        "class": "#c4457a",
        "interface": "#c4457a",
        "enum": "#c4457a",
        "type": "#c4457a",
        "typeParameter": "#c4457a",
        "function": "#1d6ccc",
        "method": "#1d6ccc",
        "decorator": "#c8501f",
        "macro": "#c8501f",
        "parameter": {
            "foreground": "#4a5a70",
            "italic": true
        },
        "property": "#3d587b",
        "enumMember": "#a86500",
        "variable": "#1b2535",
        "variable.readonly": "#a86500",
        "variable.defaultLibrary": "#a86500",
        "keyword": "#2a64b8",
        "regexp": "#c8501f",
        "string": "#12855c",
        "number": "#a86500",
        "comment": {
            "foreground": "#6f7d92",
            "italic": true
        },
        "*.deprecated": {
            "strikethrough": true
        }
    }
}
